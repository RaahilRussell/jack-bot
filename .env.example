# Required only for a real Discord login; --check works without credentials.
DISCORD_TOKEN=
COMMAND_PREFIX=j!

# Optional: both enable automatic guild leaderboard refreshes.
HYPIXEL_API_KEY=
HYPIXEL_GUILD=

DATA_DIR=data
MEDIA_DIR=media
STAFF_ROLE=Staff
ACCEPTED_ROLE=Accepted
MEMBER_ROLE=Member
GUEST_ROLE=Guest
UNVERIFIED_ROLE=Unverified
MUTED_ROLE=Muted
WAITING_CHANNEL=invite-waiting-list
INVITE_CHANNEL=invite-log
QUOTE_CHANNEL=quote-book
QUOTE_SUBMISSIONS=quote-book-submissions

# Explicit opt-in; values are Discord role names. No automatic staff role grants.
GUILD_RANK_ROLES={}
# Keeps one deleted text message per channel for a five-minute retrieval window.
ENABLE_SNIPE=false
